pipeline {
    agent {
        docker {
            image 'golang:1.24'
        }
    }

    environment {
        GOCACHE = "${WORKSPACE}/.gocache"
    }

    stages {
        stage('Unit Tests') {
            steps {
                dir('bugtracker-backend') {
                    sh 'mkdir -p $GOCACHE'
                    sh 'go version'
                    sh 'go test -v ./...'
                }
            }
        }
    }
}
